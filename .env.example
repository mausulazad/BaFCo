# Primary key — all default (OpenRouter) inference and eval use this.
OPEN_ROUTER_API_KEY=your-openrouter-api-key-here

# Optional — only needed for native batch APIs (--no-use_openrouter) or
# the batch DLA path with OpenAI / Google / Anthropic providers.
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
